# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8000

# ─── Database ─────────────────────────────────────────────────────────────────
MongoDB=mongodb://127.0.0.1:27017/scrapsaathi

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Must be at least 32 random characters
JWT_SECRET=replace-with-at-least-32-random-characters-here
JWT_EXPIRES_IN=24h

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CLIENT_ORIGINS=http://localhost:5173,https://scrap-sathi.vercel.app

# ─── Email (Primary & Fallback SMTP) ──────────────────────────────────────────
# Primary: Your ScrapSaathi email (e.g. scrapsaathi.official@gmail.com)
PRIMARY_EMAIL=your-scrapsaathi-email@gmail.com
PRIMARY_EMAIL_PASSWORD=your-gmail-app-password
EMAIL_FROM_NAME="ScrapSaathi Support"

# Fallback / Backup email (used if primary fails or is not configured)
FALLBACK_EMAIL=backup-email@gmail.com
FALLBACK_EMAIL_PASSWORD=backup-app-password

# Optional: Custom domain SMTP (e.g., mail.yourdomain.com)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# ─── Cloudinary (Image Storage) ───────────────────────────────────────────────
# Sign up at https://cloudinary.com (free tier)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# General API: window in ms (default 15 min), max requests
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# Auth endpoints (login/register): max per window
AUTH_RATE_LIMIT_MAX=10
# OTP sends: max per window
OTP_RATE_LIMIT_MAX=5

# ─── Admin User (Initial Seeding) ─────────────────────────────────────────────
ADMIN_EMAIL=admin@scrapsaathi.com
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=Super Admin
ADMIN_PHONE=9999999999

