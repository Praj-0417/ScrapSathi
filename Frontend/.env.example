# ─── ScrapSaathi Frontend Environment Template ───────────────────────────
# Copy this file to .env or configure these variables in your Vercel Dashboard

# Production Backend API URL (Your Render deployment)
# Example: https://scrapsaathi-backend.onrender.com/api
VITE_PROD_BASE_URL=https://scrapsaathi-backend.onrender.com/api

# Backup / Fallback Backend API URL (optional fallback)
VITE_FALLBACK_PROD_BASE_URL=https://sbt-1.onrender.com/api

# Development Backend API URL (local server)
VITE_DEV_BASE_URL=http://localhost:8000/api

# AI Chatbot Backend URL
VITE_BACKEND_URL=http://127.0.0.1:8001

# Google OAuth 2.0 Web Client ID
# Generate in Google Cloud Console -> APIs & Services -> Credentials
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
